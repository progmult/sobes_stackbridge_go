# Все значения рабочие: достаточно скопировать файл, менять ничего не нужно.
#   cp .env.example .env

# Порт, на котором сервис доступен на хост-машине.
# Поменяйте, если 8080 уже занят.
HTTP_HOST_PORT=8080
HTTP_PORT=8080

# Порт, на котором PostgreSQL доступен на хост-машине.
POSTGRES_HOST_PORT=5432

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=subscriptions
POSTGRES_SSLMODE=disable

# debug | info | warn | error
LOG_LEVEL=info
